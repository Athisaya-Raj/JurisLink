# --- MongoDB ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=jurislink

# --- JWT authentication -----------------------------------------------------
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Demo account identity mapping ------------------------------------------
# The `lawyer` demo account resolves to this real record in lawyer_temp.
DEMO_LAWYER_ID=LAW-FAM01-01
# The `user` demo account resolves to this stored user_id (matches seed data).
DEMO_USER_ID=demo-user

# --- Demo initialization / seeding ------------------------------------------
# When true, the dev-only demo endpoints (e.g. /admin/seed-demo) are reachable.
# Set to false in any non-local environment.
ENABLE_DEMO_ENDPOINTS=true
# Stable id used by the idempotent demo-seed routine.
DEMO_SEED_CASE_ID=DEMO-CASE-INVITE-001

# --- NLP classification -----------------------------------------------------
# MODEL_CACHE_DIR (optional) defaults to backend/app/services/.model_cache
# MIN_DESCRIPTION_LENGTH=10
# REVIEW_CONFIDENCE_THRESHOLD=0.05  (relative to the number of categories)
